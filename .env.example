# Copy to .env and fill in. Never commit .env.
# Set ONE API key. Leave both empty to run in mock mode (rule-based, no API cost).
# After changing provider, re-run: docker compose exec backend python -m scripts.ingest_policies
# LLM_PROVIDER: auto | gemini | openai
LLM_PROVIDER=auto

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# How long Gemini thinks before answering: minimal | low | medium | high (empty = model default)
GEMINI_REASONING_EFFORT=low

# OpenAI
OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_DIM=1536
CORS_ORIGINS=http://localhost:3000

# Classifier prompt used by the live pipeline: v1 | v2 | v3 (see backend/app/agents/prompts.py)
CLASSIFIER_PROMPT_VERSION=v2
# Optional: USD per 1M tokens, copied from your provider's pricing page, so evaluation,
# Monitoring and the Business Case can estimate cost (0 = not set).
# FAST = classification, translation, hallucination check; STRONG = reply drafting.
PRICE_INPUT_PER_MTOK_FAST=0
PRICE_OUTPUT_PER_MTOK_FAST=0
PRICE_INPUT_PER_MTOK_STRONG=0
PRICE_OUTPUT_PER_MTOK_STRONG=0

# Signs login sessions. Set a long random value (e.g. `openssl rand -hex 32`); never commit the real one.
AUTH_SECRET=change-me-to-a-long-random-value
SESSION_HOURS=8
